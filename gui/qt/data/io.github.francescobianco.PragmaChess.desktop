[Desktop Entry]
Type=Application
Name=Pragma Chess
GenericName=Chess Database
GenericName[it]=Database di scacchi
GenericName[es]=Base de datos de ajedrez
Comment=Browse, search and analyze chess game databases
Comment[it]=Sfoglia, cerca e analizza database di partite di scacchi
Comment[es]=Explora, busca y analiza bases de datos de partidas de ajedrez
Exec=pragma-chess %F
Icon=io.github.francescobianco.PragmaChess
Terminal=false
Categories=Game;BoardGame;
Keywords=chess;database;pgn;opening;
Keywords[it]=scacchi;database;pgn;apertura;partite;
Keywords[es]=ajedrez;base de datos;pgn;apertura;partidas;
MimeType=application/x-chess-pgn;application/x-pragma-chess-project;application/x-pragma-chess-database;
StartupWMClass=pragma-chess
