# Maintainer: Francesco Bianco <info.francescobianco@gmail.com>
pkgname=pragma-chess
pkgver=0.4.0
pkgrel=1
pkgdesc="Chess database for studying, training and playing, with Explain"
arch=('x86_64' 'aarch64')
url="https://yafb.net/pragma-chess/"
license=('MIT')
depends=('qt6-base' 'qt6-svg' 'yaml-cpp' 'openssl' 'stockfish' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'git' 'qt6-tools')
source=("$pkgname-$pkgver.tar.gz::https://github.com/francescobianco/pragma-chess/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5839f7d65dbe5c4742557546e2bb13eb4bbca471beb8f9e5c201b988648c4974')

build() {
    # WebRTC and the keys of Phone Link and the lobby (libdatachannel,
    # libsecp256k1) and the QR codes are fetched by CMake when missing.
    cmake -S "$pkgname-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DPRAGMA_VERSION="$pkgver"
    cmake --build build --target pragma-chess
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    # The engine Pragma Chess offers first is Arch's Stockfish.
    install -d "$pkgdir/usr/lib/pragma-chess/engines"
    ln -s /usr/bin/stockfish "$pkgdir/usr/lib/pragma-chess/engines/stockfish"
    install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
