# The Stockfish shipped with Pragma Chess: the one place its version is pinned.
# Read by scripts/build-stockfish.sh, packaging/windows/build.ps1 and
# gui/qt/CMakeLists.txt.
#
# We build it ourselves from the release's source with
# packaging/stockfish/small-net.patch: only the small network (3.5 MB) is
# embedded and used, instead of the big one (100 MB), so the installers stay
# small. The source archive and the network are checked against these hashes.
STOCKFISH_VERSION=18
STOCKFISH_TAG=sf_18
STOCKFISH_SOURCE_SHA256=22a195567e3493e7c9ca8bf8fa2339f4ffc876384849ac8a417ff4b919607e7b
STOCKFISH_NET=nn-37f18f62d772.nnue
STOCKFISH_NET_SHA256=37f18f62d772f3107e1d6aaca3898c130c3c86f2ab63e6555fbbca20635a899d
