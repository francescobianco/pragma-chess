<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-pragma-chess-project">
    <comment>Pragma Chess project</comment>
    <comment xml:lang="it">Progetto di Pragma Chess</comment>
    <icon name="io.github.francescobianco.pragma-chess-project"/>
    <glob pattern="*.pch" weight="60"/>
    <magic priority="60">
      <match type="string" value="# Pragma Chess project" offset="0"/>
    </magic>
  </mime-type>
  <!-- .pdb is also Protein Data Bank, Palm and Visual Studio's: the glob
       weighs less than theirs, and the magic (SQLite's application_id
       "PRAG", at offset 68) tells a database of Pragma Chess. -->
  <mime-type type="application/x-pragma-chess-database">
    <comment>Pragma Chess database</comment>
    <comment xml:lang="it">Database di Pragma Chess</comment>
    <sub-class-of type="application/vnd.sqlite3"/>
    <icon name="io.github.francescobianco.pragma-chess-database"/>
    <glob pattern="*.pdb" weight="40"/>
    <magic priority="80">
      <match type="string" value="SQLite format 3" offset="0">
        <match type="string" value="PRAG" offset="68"/>
      </match>
    </magic>
  </mime-type>
</mime-info>
